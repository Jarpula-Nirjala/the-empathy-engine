# Lightweight Docker image for Render Free/Starter (512 MB RAM).
# Same professional UI — uses VADER instead of DistilRoBERTa.
# For full transformer AI, use Dockerfile + Standard plan (2 GB).

FROM python:3.11-slim-bookworm

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    USE_VADER_ONLY=true \
    NLTK_DATA=/app/.cache/nltk \
    PORT=8000

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-vader.txt requirements.txt
RUN pip install --upgrade pip && pip install -r requirements.txt

RUN mkdir -p /app/.cache/nltk /app/audio_output \
    && python -c "import nltk; nltk.download('punkt', download_dir='/app/.cache/nltk'); nltk.download('punkt_tab', download_dir='/app/.cache/nltk')"

COPY main.py emotion_detector.py emotion_voice_map.py voice_modulator.py ssml_builder.py ./
COPY static ./static/
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN sed -i 's/\r$//' /docker-entrypoint.sh && chmod +x /docker-entrypoint.sh

EXPOSE 8000
ENTRYPOINT ["/docker-entrypoint.sh"]
