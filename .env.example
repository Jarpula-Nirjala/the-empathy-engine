# The Empathy Engine — Environment Configuration
# Copy this file to .env and adjust values as needed.

# Server host/port (used if running via custom launcher)
HOST=0.0.0.0
PORT=8000

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# HuggingFace cache directory (optional — defaults to ~/.cache/huggingface)
# HF_HOME=./.cache/huggingface

# Maximum text length for analysis/generation
MAX_TEXT_LENGTH=5000

# Audio output directory (relative to project root)
AUDIO_OUTPUT_DIR=audio_output

# Number of cached audio files to retain
AUDIO_CACHE_SIZE=10
